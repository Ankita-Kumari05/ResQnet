{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "routing-lab": {
      "root": "routing-lab",
      "framework": "vite"
    },
    "simulation_engine": {
      "root": "simulation_engine",
      "framework": "fastapi",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "RESQNET_BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/sim-api/(.*)",
      "destination": {
        "service": "simulation_engine"
      }
    },
    {
      "source": "/map-v2/(.*)",
      "destination": {
        "service": "routing-lab"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}

# Simulation Engine Environment Variables
# Copy to .env and fill in values — do NOT commit .env to version control

# ResQnet backend base URL
RESQNET_BASE_URL=http://localhost:8000

# Coordinator credentials (used for most simulation events)
SIM_COORDINATOR_EMAIL=coordinator@resqnet.in
SIM_COORDINATOR_PASSWORD=coord123

# Citizen credentials (used for citizen-source simulation events)
SIM_CITIZEN_EMAIL=citizen1@resqnet.in
SIM_CITIZEN_PASSWORD=citizen123

# Simulation Engine port
SIM_PORT=9000

# Default speed multiplier (1, 5, or 10)
SIM_DEFAULT_SPEED=1

# Path to scenario config directory
SCENARIO_DIR=./config
